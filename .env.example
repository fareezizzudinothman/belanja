# ---- Belanja environment configuration -------------------------------
# Copy this file to .env and adjust values. NEVER commit .env.

# Application
NODE_ENV=development
# Backend API port (inside the backend container; used for local non-Docker dev)
PORT=4000
# Host port where Nginx / frontend is exposed
APP_PORT=8080
# IANA timezone defining the app's "current calendar month".
# Monthly lifecycle rules (open/close/reopen/auto-close) are computed from here.
APP_TIMEZONE=Asia/Kuala_Lumpur
# Origin(s) allowed for CORS (comma separated). Same-origin through Nginx by default.
CORS_ORIGIN=http://localhost:8080
# How long JWT stays valid (e.g. 7d, 1d, 12h)
JWT_EXPIRES_IN=7d

# --- Security ----------------------------------------------------------
# IMPORTANT: generate a strong random secret:
#   openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-secret

# --- Rate limiting (requests per 15 minutes per client IP) --------------
# Overall limit for /api/auth (COVERS /me, which runs on every page load)
RATE_LIMIT_AUTH=300
# Strict limit for login + register only (brute-force guard)
RATE_LIMIT_AUTH_LOGIN=30
# Limit for all other /api endpoints
RATE_LIMIT_API=600

# --- PostgreSQL --------------------------------------------------------
# Credentials used to create the Postgres container AND the backend connection.
POSTGRES_USER=belanja
POSTGRES_PASSWORD=belanja-strong-password
POSTGRES_DB=belanja
# Postgres data schema used by the app
POSTGRES_SCHEMA=belanja
# Host port published for Postgres (host-only). 5433 avoids the default 5432.
POSTGRES_PUBLISH_PORT=127.0.0.1:5433
# Connection string used by the backend.
# Inside Docker 'postgres' is the service name. For local dev use localhost.
DATABASE_URL=postgres://belanja:belanja-strong-password@postgres:5432/belanja

# --- Cloudflare Tunnel (OPTIONAL) --------------------------------------
# Only needed when running the tunnel service: docker compose --profile tunnel up -d
# Get the token from your Cloudflare Zero Trust dashboard (Tunnels -> Create).
CLOUDFLARE_TUNNEL_TOKEN=